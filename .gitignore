# Data - raw data files are not committed (too large, sensitive)
data/raw/*
!data/raw/.gitkeep

# Processed data (regenerated by notebooks)
data/processed/*
!data/processed/.gitkeep

# Models (saved model files)
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.env
.env.*
.cdsapirc
venv/
.venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Local editor/session files and personal document outputs
.virtual_documents/
anaconda_projects/
outputs/

# Local workshop reference; publish only with permission to redistribute
DHIS2_Climate_Tools_Presentation.pptx
