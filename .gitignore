# Data - raw data files are not committed (too large, sensitive)
data/raw/*
!data/raw/.gitkeep

# Processed data (regenerated by notebooks)
data/processed/*
!data/processed/.gitkeep

# Models (saved model files)
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
